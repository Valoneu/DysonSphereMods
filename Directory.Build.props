<Project>
  <PropertyGroup>
    <Authors>Valoneu</Authors>
    <Product>DysonSphereMods</Product>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.18" PrivateAssets="all" />
    <PackageReference Include="DysonSphereProgram.GameLibs" Version="0.10.33.26943-r.0" />
    <PackageReference Include="DysonSphereProgram.Modding.CommonAPI" Version="1.6.5" />
  </ItemGroup>
</Project>
