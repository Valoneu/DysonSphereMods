<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- COMPLETE ISOLATION: DO NOT LOAD ANY OTHER PROPS -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <!-- Clear all inherited references -->
  <ItemGroup>
    <PackageReference Remove="DysonSphereProgram.GameLibs" />
    <PackageReference Remove="DysonSphereProgram.Modding.CommonAPI" />
    <PackageReference Remove="UnityEngine.Modules" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
